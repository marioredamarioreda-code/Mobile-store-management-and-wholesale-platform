# Supabase (Settings -> API). Both values are safe for the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Permanent public URL of the store. Used for SEO and the QR code.
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# NOTE: the Supabase service-role key is intentionally NOT used anywhere.
